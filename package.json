{
  "name": "sugt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:public": "turbo run dev --filter=@sugt/public",
    "dev:internal": "turbo run dev --filter=@sugt/internal",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --debug timings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.9",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0"
    }
  },
  "packageManager": "pnpm@11.20.0"
}
