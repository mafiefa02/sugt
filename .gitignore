# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are deliberately unanchored — this is a workspace, so they have to
# match under apps/* and packages/* as well as at the root.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing — anchored, unlike the rest. Unanchored, `coverage` matches a directory of
# that name at any depth, and the internal tool has a surface called Coverage: it
# silently swallowed `apps/internal/src/app/(app)/coverage/`, which typechecks locally
# and fails from a clean clone. Name the three places a runner would write it instead.
/coverage
apps/*/coverage
packages/*/coverage

# next.js
.next/
out/

# turborepo
.turbo

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# programme budget — real financial planning data (rates, per-school groupings,
# the total contract value). This repository is public; the RAB stays local.
# `docs/research/` may cite what was inferred from it, never reproduce it.
docs/RAB_*.xlsx

# the founding Staff — real names and email addresses, on the same reasoning.
# `founding-staff.example.sql` beside it is the committed template.
packages/db/seed/founding-staff.sql
