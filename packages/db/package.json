{
  "name": "@sugt/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./queries": "./src/queries/index.ts",
    "./migrations": "./src/migrations.ts",
    "./feedback-link-recovery": "./src/feedback-link-recovery.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "psql \"$DIRECT_URL\" -v ON_ERROR_STOP=1 -f seed/reference-data.sql",
    "db:seed:people": "psql \"$DIRECT_URL\" -v ON_ERROR_STOP=1 -f seed/founding-staff.sql",
    "db:reattach-links": "node scripts/reattach-feedback-links.ts"
  },
  "dependencies": {
    "@sugt/domain": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
